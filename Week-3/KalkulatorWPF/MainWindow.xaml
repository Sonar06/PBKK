<Window x:Class="KalkulatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator Sederhana" Height="500" Width="350"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Label Histori Operasi -->
        <TextBlock x:Name="OperationLabel" Grid.Row="0" Text="" 
                   TextAlignment="Right" FontSize="16" Foreground="Gray" Margin="0,10,0,0"/>
        
        <!-- Layar Utama -->
        <TextBox x:Name="DisplayLabel" Grid.Row="1" Text="0" 
                 TextAlignment="Right" FontSize="40" FontWeight="Bold" 
                 IsReadOnly="True" BorderThickness="0" Margin="0,0,0,20"/>
        
        <!-- Tombol Kalkulator -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Content="C" Click="Clear_Click" Grid.Row="0" Grid.Column="0" Margin="2" FontSize="20"/>
            <Button Content="CE" Click="ClearEntry_Click" Grid.Row="0" Grid.Column="1" Margin="2" FontSize="20"/>
            <Button Content="^" Click="Operator_Click" Grid.Row="0" Grid.Column="2" Margin="2" FontSize="20"/>
            <Button Content="√" Click="Root_Click" Grid.Row="0" Grid.Column="3" Margin="2" FontSize="20"/>
            
            <Button Content="7" Click="Number_Click" Grid.Row="1" Grid.Column="0" Margin="2" FontSize="20"/>
            <Button Content="8" Click="Number_Click" Grid.Row="1" Grid.Column="1" Margin="2" FontSize="20"/>
            <Button Content="9" Click="Number_Click" Grid.Row="1" Grid.Column="2" Margin="2" FontSize="20"/>
            <Button Content="/" Click="Operator_Click" Grid.Row="1" Grid.Column="3" Margin="2" FontSize="20"/>

            <Button Content="4" Click="Number_Click" Grid.Row="2" Grid.Column="0" Margin="2" FontSize="20"/>
            <Button Content="5" Click="Number_Click" Grid.Row="2" Grid.Column="1" Margin="2" FontSize="20"/>
            <Button Content="6" Click="Number_Click" Grid.Row="2" Grid.Column="2" Margin="2" FontSize="20"/>
            <Button Content="*" Click="Operator_Click" Grid.Row="2" Grid.Column="3" Margin="2" FontSize="20"/>

            <Button Content="1" Click="Number_Click" Grid.Row="3" Grid.Column="0" Margin="2" FontSize="20"/>
            <Button Content="2" Click="Number_Click" Grid.Row="3" Grid.Column="1" Margin="2" FontSize="20"/>
            <Button Content="3" Click="Number_Click" Grid.Row="3" Grid.Column="2" Margin="2" FontSize="20"/>
            <Button Content="-" Click="Operator_Click" Grid.Row="3" Grid.Column="3" Margin="2" FontSize="20"/>

            <Button Content="0" Click="Number_Click" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="2" FontSize="20"/>
            <Button Content="." Click="Number_Click" Grid.Row="4" Grid.Column="2" Margin="2" FontSize="20"/>
            <Button Content="+" Click="Operator_Click" Grid.Row="4" Grid.Column="3" Margin="2" FontSize="20"/>
            
            <Button Content="=" Click="Equals_Click" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Margin="2" FontSize="24" Background="#0078D7" Foreground="White"/>
        </Grid>
    </Grid>
</Window>